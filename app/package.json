    "esbuild-sass-plugin": "^3.3.1",
    "prisma": "^6.5.0",
    "sass": "^1.94.0"
  },
  "peerDependencies": {
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@elysiajs/cookie": "^0.8.0",
    "@elysiajs/static": "^1.4.4",
    "@elysiajs/stream": "^1.1.0",
    "@prisma/adapter-pg": "^6.5.0",
    "@prisma/client": "^6.5.0",
    "@simplechat/shared": "file:../shared",
    "simplechat_provider": "file:../simplechat_provider",
    "elysia": "^1.4.13",
