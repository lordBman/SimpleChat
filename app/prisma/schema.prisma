// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum Roles{
    Client
    Admin
    Developer
}
model Credential{
    id                  String            @id @unique @default(uuid())
    
    created           DateTime              @default(now())
    deleted           Deleted?
    isDeleted         Boolean               @default(false)

    username            String?
    email               String?
    password            String

    name                String
    surname             String

    role                Roles            @default(Client)
    
    client              Client?
    
    adminID             String?
    admin               Credential?            @relation("developers",fields: [adminID], references: [id])
    developers          Credential[]           @relation("developers")
    
    projects            Project[]
}

model Client{
    credentialID        String            @id
    credential          Credential        @relation(fields: [credentialID], references: [id])

    organizationID  String?
    organization    Organization?  @relation(fields: [organizationID], references: [id], onDelete: SetNull)
    
    projectID         String         
    project           Project     @relation(fields: [projectID], references: [id], onDelete: Cascade)

    requester       Friend[]      @relation("requester")
    acceptor        Friend[]      @relation("acceptor")

    notifications   Notification[]

    sentChats       Chat[]
    createdGroups   Group[]         
    members         Member[]
}

model Project{
    id                String              @id @default(uuid())
    name              String

    token             String              @default(uuid())

    ownerID           String
    owner             Credential       @relation(fields: [ownerID], references: [id], onDelete: Cascade)

    keys              AccessKey[]
    clients           Client[]
    groups            Group[]
    friends           Friend[]
    organizations     Organization[]

    created           DateTime              @default(now())
    isDeleted         Boolean               @default(false)
    deleted           Deleted?

    @@unique([name, ownerID])
}

model AccessKey{
    id                String            @id @default(uuid())
    key               String            @unique
    name              String            @unique
    enabled           Boolean           @default(false)

    projectID         String
    project           Project           @relation(fields: [projectID], references: [id], onDelete: Cascade)

    @@unique([projectID, name])
}

model Organization {
   id               String           @id @default(uuid())
   name             String

   projectID        String
   project          Project       @relation(fields: [projectID], references: [id])

   clients          Client[]
   friends          Friend[]
   groups           Group[]

   isDeleted         Boolean               @default(false)
   deleted           Deleted?

   @@unique([name, projectID])
}

enum ChatType{
    Group
    Friends
}
model Chat{
    id              String           @id @default(uuid())
    message         String
    created         DateTime      @default(now())
    deleted         Deleted?

    delivered       Boolean       @default(false)

    isDeleted         Boolean               @default(false)

    senderID        String
    sender          Client         @relation(fields: [senderID], references: [credentialID])

    ownerID         String
    friend          Friend?       @relation(fields: [ownerID], references: [id], map: "friend_fk", onDelete: Cascade)
    group           Group?        @relation(fields: [ownerID], references: [id], map: "group_fk", onDelete: Cascade)
    type            ChatType

    reply           Chat[]        @relation("reference")
    referenceID     String?
    reference       Chat?         @relation("reference", fields: [referenceID], references: [id], onDelete: SetNull)

    @@unique([id, ownerID])
}

model Friend{
    id              String        @id  @default(uuid())
    created           DateTime              @default(now())
    isDeleted         Boolean               @default(false)
    deleted         Deleted?

    requesterID     String
    requester       Client          @relation("requester", fields: [requesterID], references: [credentialID])

    acceptorID      String
    acceptor        Client          @relation("acceptor", fields: [acceptorID], references: [credentialID])

    accepted        Boolean       @default(false)

    organizationID  String?
    organization    Organization?  @relation(fields: [organizationID], references: [id], onDelete: Cascade)

    projectID       String
    project         Project        @relation(fields: [projectID], references: [id])

    chats           Chat[]

    @@unique([requesterID, acceptorID, projectID])
}

model Group {
    id              String              @id @unique @default(uuid())
    name            String
    last            DateTime            @default(now())
    attachment      String?

    created           DateTime              @default(now())
    isDeleted         Boolean               @default(false)
    deleted         Deleted?

    creatorID       String
    creator         Client                @relation(fields: [creatorID], references: [credentialID], onDelete: NoAction)

    organizationID  String?
    organization    Organization?        @relation(fields: [organizationID], references: [id], onDelete: Cascade)

    projectID       String
    project         Project             @relation(fields: [projectID], references: [id])

    members         Member[]
    notifications   Notification[]
    chats           Chat[]
}

enum MemberRole{
    Member
    Admin
}

model Member {
    credentialID        String            @unique()
    client              Client            @relation(fields: [credentialID], references: [credentialID])

    group             Group             @relation(fields: [groupID], references: [id], onDelete: Cascade)
    groupID           String

    joined            DateTime          @default(now())
    role              MemberRole        @default(Member)

    accepted          Boolean           @default(false)

    deleted           DateTime?
    isDeleted         Boolean               @default(false)

    @@id([credentialID, groupID])
}

model Notification{
    id                Int               @id @default(autoincrement())
    message           String?
    alert             String  
    created           DateTime          @default(now())
    received          Boolean           @default(false)

    groupID           String?
    group             Group?            @relation(fields: [groupID], references: [id], onDelete: SetNull)

    reciecver         Client            @relation(fields: [recieverID], references: [credentialID], onDelete: Cascade)
    recieverID        String
}

enum ResourceType{
    Credential
    Project
    Group
    Chat
    Friend
    Organization
}

model Deleted{
    resourceID          String @unique
    on                  DateTime  @default(now())

    credential          Credential?   @relation(fields: [resourceID], references: [id], map: "credential_fk", onDelete: Cascade)
    friend              Friend?       @relation(fields: [resourceID], references: [id], map: "friend_fk", onDelete: Cascade)
    group               Group?        @relation(fields: [resourceID], references: [id], map: "group_fk", onDelete: Cascade)
    chat                Chat?         @relation(fields: [resourceID], references: [id], map: "chat_fk", onDelete: Cascade)
    project             Project?      @relation(fields: [resourceID], references: [id], map: "project_fk", onDelete: Cascade)
    organization        Organization? @relation(fields: [resourceID], references: [id], map: "organization_fk", onDelete: Cascade)
    type                ResourceType
}
