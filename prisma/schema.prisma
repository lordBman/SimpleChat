// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Credential{
    id                  String            @id @unique @default(uuid())

    username            String?
    email               String?
    password            String

    name                String
    surname             String

    role                String            @default("client")
    
    client              Client?
    admin               Admin?
    developer           Developer?
}

model Admin{
    credentialID        String            @id
    credential          Credential        @relation(fields: [credentialID], references: [id])

    developers          Developer[]
    projects            Project[]         @relation("adminProjects")
}

model Developer{
    credentialID        String            @id
    credential          Credential        @relation(fields: [credentialID], references: [id])

    adminID             String
    admin               Admin            @relation(fields: [adminID], references: [credentialID])

    projects            Project[]       @relation("developerProjects")
}

model Client{
    credentialID        String            @id
    credential          Credential        @relation(fields: [credentialID], references: [id])

    organizationID  Int?
    organization    Organization?  @relation(fields: [organizationID], references: [id], onDelete: SetNull)
    
    projectID         String         
    project           Project     @relation(fields: [projectID], references: [id], onDelete: Cascade)

    requester       Friend[]      @relation("requester")
    acceptor        Friend[]      @relation("acceptor")

    notifications   Notification[]

    sentChats       Chat[]
    createdGroups   Group[]         
    members         Member[]
}

model Project{
    id                String              @id @default(uuid())
    name              String           @unique

    ownerID           String
    developer         Developer?       @relation("developerProjects", fields: [ownerID], references: [credentialID], map: "developer_fk", onDelete: Cascade)
    admin             Admin?           @relation("adminProjects", fields: [ownerID], references: [credentialID], map: "admin_fk", onDelete: Cascade)

    keys              AccessKey[]
    clients           Client[]
    groups            Group[]
    friends           Friend[]
    organizations     Organization[]
}

model AccessKey{
    id                String            @id @default(uuid())
    key               String            @unique
    name              String            @unique
    enabled           Boolean           @default(false)

    projectID         String
    project           Project           @relation(fields: [projectID], references: [id], onDelete: Cascade)

    @@unique([projectID, name])
}

model Organization {
   id               Int           @id @default(autoincrement())
   name             String

   projectID        String
   project          Project       @relation(fields: [projectID], references: [id])

   clients          Client[]
   friends          Friend[]
   groups           Group[]

   @@unique([name, projectID])
}

model Chat{
    id              Int           @id @default(autoincrement())
    message         String
    created         DateTime      @default(now())
    delivered       Boolean       @default(false)

    senderID        String
    sender          Client         @relation(fields: [senderID], references: [credentialID])

    ownerID         String

    reply           Chat[]        @relation("reference")
    referenceID     Int?
    reference       Chat?         @relation("reference", fields: [referenceID], references: [id], onDelete: SetNull)

    @@unique([id, ownerID])
}

model Friend{
    id              String        @id

    requesterID     String
    requester       Client          @relation("requester", fields: [requesterID], references: [credentialID])

    acceptorID      String
    acceptor        Client          @relation("acceptor", fields: [acceptorID], references: [credentialID])

    accepted        Boolean       @default(false)

    organizationID  Int?
    organization    Organization?  @relation(fields: [organizationID], references: [id], onDelete: Cascade)

    projectID       String
    project         Project        @relation(fields: [projectID], references: [id])

    @@unique([requesterID, acceptorID, projectID])
}

model Group {
    id              String              @id @unique
    name            String
    last            DateTime            @default(now())
    attachment      String?

    creatorID       String
    creator         Client                @relation(fields: [creatorID], references: [credentialID], onDelete: NoAction)

    organizationID  Int?
    organization    Organization?        @relation(fields: [organizationID], references: [id], onDelete: Cascade)

    projectID       String
    project         Project             @relation(fields: [projectID], references: [id])

    members         Member[]
    notifications   Notification[]
}

model Member {
    credentialID        String            @unique()
    client              Client            @relation(fields: [credentialID], references: [credentialID])

    group             Group             @relation(fields: [groupID], references: [id], onDelete: Cascade)
    groupID           String

    joined            DateTime          @default(now())
    role              String            @default("member")

    accepted          Boolean           @default(false)

    @@id([credentialID, groupID])
}

model Notification{
    id                Int               @id @default(autoincrement())
    message           String?
    alert             String  
    created           DateTime          @default(now())
    received          Boolean           @default(false)

    groupID           String?
    group             Group?            @relation(fields: [groupID], references: [id], onDelete: SetNull)

    reciecver         Client            @relation(fields: [recieverID], references: [credentialID], onDelete: Cascade)
    recieverID        String
}
